@page "/Forums/Index"
@model ForumsModel

@{
    ViewData["Title"] = "Forums";
}

<h1>Forums</h1>

<p>Forum count: @Model.Items.Count</p>

@if (!Model.Items.Any())
{
    <div class="alert alert-warning">
        No forums found.
    </div>
}
else
{
    @foreach (var forum in Model.Items)
    {
        <partial name="_ForumCard" model="forum" />
    }
}

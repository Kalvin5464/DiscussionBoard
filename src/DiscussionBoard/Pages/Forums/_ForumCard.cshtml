@model DiscussionBoard.Models.Forum
<article class="card mb-3">
    <div class="card-body">
        <h2 class="h5"><a asp-page="/Forums/Details" asp-route-id="@Model.Id">@Model.Name</a></h2>
        <a asp-page="/Forums/Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">View Forum</a>
        <p>@Model.Description</p>
    </div>
</article>

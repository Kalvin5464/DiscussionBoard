@model DiscussionBoard.Models.Forum

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">
            <a asp-page="/Forums/Details"
               asp-route-id="@Model.Id">
                @Model.Name
            </a>
        </h2>

        <p>@Model.Description</p>

        <a asp-page="/Forums/Details"
           asp-route-id="@Model.Id"
           class="btn btn-sm btn-outline-primary">
            View Forum
        </a>
    </div>
</div>

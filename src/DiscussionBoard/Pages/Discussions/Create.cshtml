@page "{forumId:int}"
@model DiscussionBoard.Pages.Discussions.CreateModel

<h1>Start a New Discussion in @Model.Forum?.Name</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label">Title</label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Content" class="form-label">Content</label>
        <textarea asp-for="Input.Content" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Input.Content" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Post Discussion</button>
</form>

<a asp-page="/Forums/Details" asp-route-id="@Model.Forum?.Id">Cancel and return to Forum</a>

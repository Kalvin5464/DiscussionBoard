@page "/Discussion/{threadId:int}"
@model DiscussionBoard.Pages.Discussions.DetailsModel

<h1>@Model.Thread?.Title</h1>
<p>@Model.Thread?.Content</p>
<small class="text-muted">
    Started by @Model.Thread?.ApplicationUser?.UserName — @Model.Thread?.CreatedAt.ToLocalTime().ToString("g")
</small>

@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" asp-page-handler="Reply" asp-route-threadId="@Model.Thread?.Id" class="mt-3">
        <input type="hidden" name="Input.ParentPostId" value="" />
        <label for="rootReplyContent">Reply to this discussion</label>
        <textarea id="rootReplyContent" name="Input.Content" class="form-control" required maxlength="10000"></textarea>
        <button type="submit" class="btn btn-primary mt-2">Post reply</button>
    </form>
}

<hr class="my-4" />

@if (Model.PostTree.Count == 0)
{
    <p>No replies yet. Be the first to respond.</p>
}
else
{
    @foreach (var node in Model.PostTree)
    {
        <partial name="/Pages/Discussions/_PostTree.cshtml" model="node" />
    }
}

<a asp-page="/Forums/Details" asp-route-id="@Model.Thread?.ForumId">Return to Forum</a>
